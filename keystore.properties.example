# Copy this file to keystore.properties (same folder, project root) and fill in
# your real values. keystore.properties itself is gitignored — never commit it.
#
# storeFile can be an absolute path, e.g. /Users/you/serein-keys/serein-release.jks

storeFile=/absolute/path/to/serein-release.jks
storePassword=yourStorePassword
keyAlias=serein
keyPassword=yourKeyPassword
