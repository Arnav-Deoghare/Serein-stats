<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer rules for Android 12+ (API 31+), referenced via
  android:dataExtractionRules. Covers both cloud backup and device-to-device
  transfer. Only the usage-history database is included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="serein.db"/>
        <include domain="database" path="serein.db-wal"/>
        <include domain="database" path="serein.db-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="serein.db"/>
        <include domain="database" path="serein.db-wal"/>
        <include domain="database" path="serein.db-shm"/>
    </device-transfer>
</data-extraction-rules>    